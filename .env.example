PROJECT_NAME="Campus Management System"
ENVIRONMENT=development

# Database Configuration
POSTGRES_USER=campus_admin
POSTGRES_PASSWORD=campus_secure_password
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=campus_db
DATABASE_URL=postgresql+asyncpg://campus_admin:campus_secure_password@localhost:5432/campus_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=campus_management_super_secret_jwt_key_32_bytes_min!
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Services Integration
AI_SERVICE_URL=http://localhost:8001
