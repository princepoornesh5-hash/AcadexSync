rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // SECURITY HELPER FUNCTIONS
    // =========================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isActiveUser() {
      return isSignedIn() && userProfile() != null && userProfile().data.accountStatus == 'active';
    }

    function userRole() {
      return (userProfile() != null) ? userProfile().data.role : null;
    }

    function isSuperAdmin() {
      return isSignedIn() && userRole() in ['SUPER_ADMIN', 'Super Admin', 'SuperAdmin', 'SUPERADMIN'];
    }

    function isCollegeAdmin() {
      return isSignedIn() && userRole() in ['COLLEGE_ADMIN', 'College Admin', 'CollegeAdmin', 'COLLEGEADMIN'];
    }

    function isHOD() {
      return isSignedIn() && userRole() in ['HOD', 'Hod', 'hod'];
    }

    function isFaculty() {
      return isSignedIn() && userRole() in ['FACULTY', 'Faculty', 'faculty'];
    }

    function isStudent() {
      return isSignedIn() && userRole() in ['STUDENT', 'Student', 'student'];
    }

    function isDelegatedTimetableFaculty() {
      return isFaculty() && (
        userProfile().data.canManageTimetable == true || 
        userProfile().data.isTimetableCoordinator == true ||
        userProfile().data.delegatedTimetableManagement == true
      );
    }

    // =========================================================
    // USERS COLLECTION
    // =========================================================

    match /users/{uid} {
      allow read: if isSignedIn() && (
        isOwnUser(uid) || 
        (isActiveUser() && (
          isSuperAdmin() || 
          (isCollegeAdmin() && userProfile().data.collegeId == resource.data.collegeId) ||
          (isHOD() && userProfile().data.collegeId == resource.data.collegeId) ||
          (isFaculty() && userProfile().data.collegeId == resource.data.collegeId)
        ))
      );

      // Prevent self-elevation of security fields
      allow create: if isSignedIn() && (
        isSuperAdmin() || 
        (isCollegeAdmin() && userProfile().data.collegeId == request.resource.data.collegeId && request.resource.data.role in ['COLLEGE_ADMIN', 'HOD', 'FACULTY', 'STUDENT']) ||
        (isOwnUser(uid) && request.resource.data.role in ['STUDENT', 'FACULTY'])
      );

      allow update: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() ||
        (isCollegeAdmin() && userProfile().data.collegeId == resource.data.collegeId && request.resource.data.collegeId == userProfile().data.collegeId && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) || request.resource.data.role in ['COLLEGE_ADMIN', 'HOD', 'FACULTY', 'STUDENT'])) ||
        (isOwnUser(uid) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'role', 'collegeId', 'departmentId', 'accountStatus', 'firebaseUid', 'status', 'employeeId', 'rollNumber'
          ])
        )
      );

      allow delete: if isSignedIn() && isActiveUser() && isSuperAdmin();
    }

    // =========================================================
    // COLLEGES
    // =========================================================

    match /colleges/{collegeId} {
      allow read: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() || 
        userProfile().data.collegeId == collegeId
      );
      allow create, delete: if isSignedIn() && isActiveUser() && isSuperAdmin();
      allow update: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() || 
        (isCollegeAdmin() && userProfile().data.collegeId == collegeId)
      );
    }

    // =========================================================
    // DEPARTMENTS
    // =========================================================

    match /departments/{departmentId} {
      allow read: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() || 
        userProfile().data.collegeId == resource.data.collegeId
      );
      allow create: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() || 
        (isCollegeAdmin() && userProfile().data.collegeId == request.resource.data.collegeId)
      );
      allow update: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() || 
        (isCollegeAdmin() && userProfile().data.collegeId == resource.data.collegeId && request.resource.data.collegeId == userProfile().data.collegeId)
      );
      allow delete: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() || 
        (isCollegeAdmin() && userProfile().data.collegeId == resource.data.collegeId)
      );
    }

    // =========================================================
    // COURSES, ACADEMIC YEARS, SEMESTERS, SECTIONS, SUBJECTS
    // =========================================================

    // Removed recursive helper functions for courses, semesters, and sections as collegeId is now available directly.

    match /courses/{courseId} {
      allow read: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() || 
        userProfile().data.collegeId == resource.data.collegeId
      );
      allow create: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() || 
        (isCollegeAdmin() && userProfile().data.collegeId == request.resource.data.collegeId)
      );
      allow update: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() || 
        (isCollegeAdmin() && userProfile().data.collegeId == resource.data.collegeId && request.resource.data.collegeId == userProfile().data.collegeId)
      );
      allow delete: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() || 
        (isCollegeAdmin() && userProfile().data.collegeId == resource.data.collegeId)
      );
    }

    match /academicYears/{academicYearId} {
      allow read: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() || 
        userProfile().data.collegeId == resource.data.collegeId
      );
      allow create: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() || 
        (isCollegeAdmin() && userProfile().data.collegeId == request.resource.data.collegeId)
      );
      allow update: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() || 
        (isCollegeAdmin() && userProfile().data.collegeId == resource.data.collegeId && request.resource.data.collegeId == userProfile().data.collegeId)
      );
      allow delete: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() || 
        (isCollegeAdmin() && userProfile().data.collegeId == resource.data.collegeId)
      );
    }

    match /semesters/{semesterId} {
      allow read: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() || 
        userProfile().data.collegeId == resource.data.collegeId
      );
      allow create: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() || 
        (isCollegeAdmin() && userProfile().data.collegeId == request.resource.data.collegeId)
      );
      allow update: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() || 
        (isCollegeAdmin() && userProfile().data.collegeId == resource.data.collegeId && request.resource.data.collegeId == userProfile().data.collegeId)
      );
      allow delete: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() || 
        (isCollegeAdmin() && userProfile().data.collegeId == resource.data.collegeId)
      );
    }

    match /sections/{sectionId} {
      allow read: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() || 
        userProfile().data.collegeId == resource.data.collegeId
      );
      allow create: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() || 
        (isCollegeAdmin() && userProfile().data.collegeId == request.resource.data.collegeId)
      );
      allow update: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() || 
        (isCollegeAdmin() && userProfile().data.collegeId == resource.data.collegeId && request.resource.data.collegeId == userProfile().data.collegeId)
      );
      allow delete: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() || 
        (isCollegeAdmin() && userProfile().data.collegeId == resource.data.collegeId)
      );
    }

    match /subjects/{subjectId} {
      allow read: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() || 
        userProfile().data.collegeId == resource.data.collegeId
      );
      allow create: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() || 
        (isCollegeAdmin() && userProfile().data.collegeId == request.resource.data.collegeId)
      );
      allow update: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() || 
        (isCollegeAdmin() && userProfile().data.collegeId == resource.data.collegeId && request.resource.data.collegeId == userProfile().data.collegeId)
      );
      allow delete: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() || 
        (isCollegeAdmin() && userProfile().data.collegeId == resource.data.collegeId)
      );
    }

    // =========================================================
    // FACULTY
    // =========================================================

    match /faculty/{facultyId} {
      allow read: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() || 
        userProfile().data.collegeId == resource.data.collegeId
      );
      allow create: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() || 
        (isCollegeAdmin() && userProfile().data.collegeId == request.resource.data.collegeId) || 
        (isHOD() && userProfile().data.collegeId == request.resource.data.collegeId && userProfile().data.departmentId == request.resource.data.departmentId)
      );
      allow update: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() || 
        (isCollegeAdmin() && userProfile().data.collegeId == resource.data.collegeId && request.resource.data.collegeId == userProfile().data.collegeId) || 
        (isHOD() && userProfile().data.collegeId == resource.data.collegeId && userProfile().data.departmentId == resource.data.departmentId && request.resource.data.collegeId == userProfile().data.collegeId && request.resource.data.departmentId == userProfile().data.departmentId)
      );
      allow delete: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() || 
        (isCollegeAdmin() && userProfile().data.collegeId == resource.data.collegeId) || 
        (isHOD() && userProfile().data.collegeId == resource.data.collegeId && userProfile().data.departmentId == resource.data.departmentId)
      );
    }

    // =========================================================
    // STUDENTS
    // =========================================================

    match /students/{studentId} {
      allow read: if isSignedIn() && isActiveUser() && (
        isOwnUser(studentId) || 
        isSuperAdmin() || 
        (isCollegeAdmin() && userProfile().data.collegeId == resource.data.collegeId) ||
        (isHOD() && userProfile().data.collegeId == resource.data.collegeId) ||
        (isFaculty() && userProfile().data.collegeId == resource.data.collegeId)
      );
      allow create: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() || 
        (isCollegeAdmin() && userProfile().data.collegeId == request.resource.data.collegeId) || 
        (isHOD() && userProfile().data.collegeId == request.resource.data.collegeId && userProfile().data.departmentId == request.resource.data.departmentId)
      );
      allow update: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() || 
        (isCollegeAdmin() && userProfile().data.collegeId == resource.data.collegeId && request.resource.data.collegeId == userProfile().data.collegeId) || 
        (isHOD() && userProfile().data.collegeId == resource.data.collegeId && userProfile().data.departmentId == resource.data.departmentId && request.resource.data.collegeId == userProfile().data.collegeId && request.resource.data.departmentId == userProfile().data.departmentId)
      );
      allow delete: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() || 
        (isCollegeAdmin() && userProfile().data.collegeId == resource.data.collegeId) || 
        (isHOD() && userProfile().data.collegeId == resource.data.collegeId && userProfile().data.departmentId == resource.data.departmentId)
      );
    }

    // =========================================================
    // STUDENT ACADEMIC HISTORY
    // =========================================================

    match /studentAcademicHistory/{historyId} {
      allow read: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() || 
        (isStudent() && resource.data.studentUid == request.auth.uid) ||
        (isCollegeAdmin() && userProfile().data.collegeId == resource.data.collegeId) ||
        (isHOD() && userProfile().data.collegeId == resource.data.collegeId && userProfile().data.departmentId == resource.data.departmentId) ||
        (isFaculty() && userProfile().data.collegeId == resource.data.collegeId)
      );
      allow create: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() || 
        (isCollegeAdmin() && userProfile().data.collegeId == request.resource.data.collegeId) || 
        (isHOD() && userProfile().data.collegeId == request.resource.data.collegeId && userProfile().data.departmentId == request.resource.data.departmentId)
      );
      allow update: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() || 
        (isCollegeAdmin() && userProfile().data.collegeId == resource.data.collegeId && request.resource.data.collegeId == userProfile().data.collegeId) || 
        (isHOD() && userProfile().data.collegeId == resource.data.collegeId && userProfile().data.departmentId == resource.data.departmentId && request.resource.data.collegeId == userProfile().data.collegeId && request.resource.data.departmentId == userProfile().data.departmentId)
      );
      allow delete: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() || 
        (isCollegeAdmin() && userProfile().data.collegeId == resource.data.collegeId) || 
        (isHOD() && userProfile().data.collegeId == resource.data.collegeId && userProfile().data.departmentId == resource.data.departmentId)
      );
    }

    // =========================================================
    // FACULTY ASSIGNMENTS
    // =========================================================

    match /facultyAssignments/{assignmentId} {
      allow read: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() || 
        userProfile().data.collegeId == resource.data.collegeId
      );
      allow create: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() || 
        (isCollegeAdmin() && userProfile().data.collegeId == request.resource.data.collegeId) || 
        (isHOD() && userProfile().data.collegeId == request.resource.data.collegeId && userProfile().data.departmentId == request.resource.data.departmentId)
      );
      allow update: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() || 
        (isCollegeAdmin() && userProfile().data.collegeId == resource.data.collegeId && request.resource.data.collegeId == userProfile().data.collegeId) || 
        (isHOD() && userProfile().data.collegeId == resource.data.collegeId && userProfile().data.departmentId == resource.data.departmentId && request.resource.data.collegeId == userProfile().data.collegeId && request.resource.data.departmentId == userProfile().data.departmentId)
      );
      allow delete: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() || 
        (isCollegeAdmin() && userProfile().data.collegeId == resource.data.collegeId) || 
        (isHOD() && userProfile().data.collegeId == resource.data.collegeId && userProfile().data.departmentId == resource.data.departmentId)
      );
    }

    // =========================================================
    // ATTENDANCE SESSIONS
    // =========================================================

    match /attendanceSessions/{sessionId} {
      allow read: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() || 
        userProfile().data.collegeId == resource.data.collegeId
      );
      allow create: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() || 
        (isCollegeAdmin() && userProfile().data.collegeId == request.resource.data.collegeId) ||
        (isHOD() && userProfile().data.collegeId == request.resource.data.collegeId && userProfile().data.departmentId == request.resource.data.departmentId) ||
        (isFaculty() && userProfile().data.collegeId == request.resource.data.collegeId && userProfile().data.id == request.resource.data.facultyId)
      );
      allow update: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() || 
        (isCollegeAdmin() && userProfile().data.collegeId == resource.data.collegeId && request.resource.data.collegeId == userProfile().data.collegeId) ||
        (isHOD() && userProfile().data.collegeId == resource.data.collegeId && userProfile().data.departmentId == resource.data.departmentId && request.resource.data.collegeId == userProfile().data.collegeId && request.resource.data.departmentId == userProfile().data.departmentId) ||
        (isFaculty() && userProfile().data.collegeId == resource.data.collegeId && userProfile().data.id == resource.data.facultyId && request.resource.data.collegeId == userProfile().data.collegeId && request.resource.data.facultyId == userProfile().data.id)
      );
      allow delete: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() || 
        (isCollegeAdmin() && userProfile().data.collegeId == resource.data.collegeId) ||
        (isHOD() && userProfile().data.collegeId == resource.data.collegeId && userProfile().data.departmentId == resource.data.departmentId) ||
        (isFaculty() && userProfile().data.collegeId == resource.data.collegeId && userProfile().data.id == resource.data.facultyId)
      );
    }

    // =========================================================
    // ATTENDANCE RECORDS (PER STUDENT)
    // =========================================================

    match /attendance/{attendanceId} {
      allow read: if isSignedIn() && isActiveUser() && (
        isOwnUser(resource.data.studentId) ||
        isSuperAdmin() ||
        (isCollegeAdmin() && userProfile().data.collegeId == resource.data.collegeId) ||
        (isHOD() && userProfile().data.collegeId == resource.data.collegeId) ||
        (isFaculty() && userProfile().data.collegeId == resource.data.collegeId)
      );

      allow create: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() || 
        (isCollegeAdmin() && userProfile().data.collegeId == request.resource.data.collegeId) ||
        (isHOD() && userProfile().data.collegeId == request.resource.data.collegeId && userProfile().data.departmentId == request.resource.data.departmentId) ||
        (isFaculty() && userProfile().data.collegeId == request.resource.data.collegeId && userProfile().data.id == request.resource.data.facultyId)
      ) && request.resource.data.status in ['present', 'absent', 'late', 'medicalLeave', 'onDuty', 'holiday'];

      allow update: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() || 
        (isCollegeAdmin() && userProfile().data.collegeId == resource.data.collegeId && request.resource.data.collegeId == userProfile().data.collegeId) ||
        (isHOD() && userProfile().data.collegeId == resource.data.collegeId && userProfile().data.departmentId == resource.data.departmentId && request.resource.data.departmentId == userProfile().data.departmentId) ||
        (isFaculty() && userProfile().data.collegeId == resource.data.collegeId && userProfile().data.id == resource.data.facultyId && request.resource.data.facultyId == userProfile().data.id)
      ) && request.resource.data.status in ['present', 'absent', 'late', 'medicalLeave', 'onDuty', 'holiday'] &&
        request.resource.data.studentId == resource.data.studentId &&
        request.resource.data.subjectId == resource.data.subjectId &&
        request.resource.data.sectionId == resource.data.sectionId;

      allow delete: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() || 
        (isCollegeAdmin() && userProfile().data.collegeId == resource.data.collegeId)
      );
    }

    // =========================================================
    // ACTIVATION CODES
    // =========================================================

    match /activationCodes/{activationId} {
      // SECURITY VULNERABILITY:
      // Firestore rule evaluation occurs after the query is constructed, and we cannot restrict `list` queries 
      // by parameter filtering within the rules engine (e.g. enforcing "where rollNumber == X").
      // Because users are unauthenticated at the time of activation, this `allow read: if true;` exposes the 
      // entire collection to public enumeration.
      // 
      // RECOMMENDED FIX: Move activation logic to a Firebase Cloud Function.
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn() && (isSuperAdmin() || isCollegeAdmin() || isHOD() || isFaculty());
      allow update: if isSignedIn() && request.resource.data.status == 'used' && resource.data.status == 'pending';
      allow delete: if isSignedIn() && isSuperAdmin();
    }
    // =========================================================
    // NOTIFICATIONS
    // =========================================================

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && isActiveUser() && (
        (resource.data.audienceType == 'personal' && resource.data.recipientUserId == request.auth.uid) ||
        (resource.data.audienceType == 'role' && resource.data.recipientRole == userRole()) ||
        (resource.data.audienceType == 'department' && resource.data.departmentId == userProfile().data.departmentId) ||
        (resource.data.audienceType == 'college' && resource.data.collegeId == userProfile().data.collegeId) ||
        (resource.data.audienceType == 'platform')
      );

      // Create: Platform -> SuperAdmin, College -> CollegeAdmin, Dept -> HOD
      allow create: if isSignedIn() && isActiveUser() && (
        (request.resource.data.audienceType == 'personal' && (isSuperAdmin() || isCollegeAdmin() || isHOD() || isFaculty())) ||
        (request.resource.data.audienceType == 'platform' && isSuperAdmin()) ||
        (request.resource.data.audienceType == 'college' && (isSuperAdmin() || (isCollegeAdmin() && userProfile().data.collegeId == request.resource.data.collegeId))) ||
        (request.resource.data.audienceType == 'department' && (isSuperAdmin() || isCollegeAdmin() || (isHOD() && userProfile().data.departmentId == request.resource.data.departmentId))) ||
        (request.resource.data.audienceType == 'role' && (isSuperAdmin() || isCollegeAdmin() || isHOD()))
      );

      // Update: Users can only update their own personal notification read status
      allow update: if isSignedIn() && isActiveUser() && (
        (resource.data.audienceType == 'personal' && resource.data.recipientUserId == request.auth.uid &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'id', 'title', 'message', 'category', 'priority', 'audienceType', 'timestamp', 'recipientUserId', 'recipientRole', 'collegeId', 'departmentId'
          ])
        ) ||
        (isSuperAdmin())
      );

      allow delete: if isSignedIn() && isActiveUser() && (
        (resource.data.audienceType == 'personal' && resource.data.recipientUserId == request.auth.uid) ||
        (isSuperAdmin())
      );
    }

    // =========================================================
    // TIMETABLE (PUBLISHED ATTENDANCE PROJECTION PLANE)
    // =========================================================
    match /timetable/{timetableId} {
      allow read: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() ||
        userProfile().data.collegeId == resource.data.collegeId
      );
      allow create: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() ||
        (isCollegeAdmin() && request.resource.data.collegeId == userProfile().data.collegeId) ||
        (isHOD() && request.resource.data.collegeId == userProfile().data.collegeId && request.resource.data.departmentId == userProfile().data.departmentId) ||
        (isDelegatedTimetableFaculty() && request.resource.data.collegeId == userProfile().data.collegeId && request.resource.data.departmentId == userProfile().data.departmentId)
      );
      allow update: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() ||
        (isCollegeAdmin() && resource.data.collegeId == userProfile().data.collegeId && request.resource.data.collegeId == userProfile().data.collegeId) ||
        (isHOD() && resource.data.collegeId == userProfile().data.collegeId && resource.data.departmentId == userProfile().data.departmentId && request.resource.data.collegeId == userProfile().data.collegeId && request.resource.data.departmentId == userProfile().data.departmentId) ||
        (isDelegatedTimetableFaculty() && resource.data.collegeId == userProfile().data.collegeId && resource.data.departmentId == userProfile().data.departmentId && request.resource.data.collegeId == userProfile().data.collegeId && request.resource.data.departmentId == userProfile().data.departmentId)
      );
      allow delete: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() ||
        (isCollegeAdmin() && resource.data.collegeId == userProfile().data.collegeId) ||
        (isHOD() && resource.data.collegeId == userProfile().data.collegeId && resource.data.departmentId == userProfile().data.departmentId) ||
        (isDelegatedTimetableFaculty() && resource.data.collegeId == userProfile().data.collegeId && resource.data.departmentId == userProfile().data.departmentId)
      );
    }

    // =========================================================
    // TIMETABLES (AUTHORING CONTAINER & SPREADSHEET PLANE)
    // =========================================================
    match /timetables/{timetableId} {
      allow read: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() ||
        userProfile().data.collegeId == resource.data.collegeId
      );
      allow create: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() ||
        (isCollegeAdmin() && request.resource.data.collegeId == userProfile().data.collegeId) ||
        (isHOD() && request.resource.data.collegeId == userProfile().data.collegeId && request.resource.data.departmentId == userProfile().data.departmentId) ||
        (isDelegatedTimetableFaculty() && request.resource.data.collegeId == userProfile().data.collegeId && request.resource.data.departmentId == userProfile().data.departmentId)
      );
      allow update: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() ||
        (isCollegeAdmin() && resource.data.collegeId == userProfile().data.collegeId && request.resource.data.collegeId == userProfile().data.collegeId) ||
        (isHOD() && resource.data.collegeId == userProfile().data.collegeId && resource.data.departmentId == userProfile().data.departmentId && request.resource.data.collegeId == userProfile().data.collegeId && request.resource.data.departmentId == userProfile().data.departmentId) ||
        (isDelegatedTimetableFaculty() && resource.data.collegeId == userProfile().data.collegeId && resource.data.departmentId == userProfile().data.departmentId && request.resource.data.collegeId == userProfile().data.collegeId && request.resource.data.departmentId == userProfile().data.departmentId)
      );
      allow delete: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() ||
        (isCollegeAdmin() && resource.data.collegeId == userProfile().data.collegeId) ||
        (isHOD() && resource.data.collegeId == userProfile().data.collegeId && resource.data.departmentId == userProfile().data.departmentId)
      );

      // Subcollections (periods, breaks, entries)
      match /periods/{periodId} {
        allow read: if isSignedIn() && isActiveUser();
        allow write: if isSignedIn() && isActiveUser() && (
          isSuperAdmin() ||
          isCollegeAdmin() ||
          isHOD() ||
          isDelegatedTimetableFaculty()
        );
      }

      match /breaks/{breakId} {
        allow read: if isSignedIn() && isActiveUser();
        allow write: if isSignedIn() && isActiveUser() && (
          isSuperAdmin() ||
          isCollegeAdmin() ||
          isHOD() ||
          isDelegatedTimetableFaculty()
        );
      }

      match /entries/{entryId} {
        allow read: if isSignedIn() && isActiveUser();
        allow write: if isSignedIn() && isActiveUser() && (
          isSuperAdmin() ||
          isCollegeAdmin() ||
          isHOD() ||
          isDelegatedTimetableFaculty()
        );
      }
    }

    // =========================================================
    // CERTIFICATE REQUESTS
    // =========================================================
    match /certificateRequests/{requestId} {
      allow read: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() ||
        (isCollegeAdmin() && userProfile().data.collegeId == resource.data.collegeId) ||
        (isHOD() && userProfile().data.departmentId == resource.data.departmentId) ||
        (isOwnUser(resource.data.studentUserId))
      );

      allow create: if isSignedIn() && isActiveUser() && (
        isOwnUser(request.resource.data.studentUserId)
      );

      allow update: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() ||
        (isCollegeAdmin() && userProfile().data.collegeId == resource.data.collegeId && request.resource.data.collegeId == userProfile().data.collegeId) ||
        (isHOD() && userProfile().data.departmentId == resource.data.departmentId && request.resource.data.departmentId == userProfile().data.departmentId)
      ) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['studentId', 'studentUserId', 'certificateTypeId', 'certificateTypeName', 'requestedAt', 'createdAt'])
      );

      allow delete: if isSignedIn() && isActiveUser() && isSuperAdmin();
    }
    
    // =========================================================
    // NOTES
    // =========================================================
    match /notes/{noteId} {
      allow read: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() ||
        (isCollegeAdmin() && userProfile().data.collegeId == resource.data.collegeId) ||
        (isHOD() && userProfile().data.collegeId == resource.data.collegeId && userProfile().data.departmentId == resource.data.departmentId) ||
        (isFaculty() && resource.data.authorUserId == request.auth.uid) ||
        (resource.data.status == 'published' && userProfile().data.collegeId == resource.data.collegeId)
      );

      allow create: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() ||
        (isCollegeAdmin() && request.resource.data.collegeId == userProfile().data.collegeId) ||
        (isHOD() && request.resource.data.collegeId == userProfile().data.collegeId && request.resource.data.departmentId == userProfile().data.departmentId) ||
        (isFaculty() && request.resource.data.collegeId == userProfile().data.collegeId && request.resource.data.authorUserId == request.auth.uid)
      );

      allow update: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() ||
        (isCollegeAdmin() && resource.data.collegeId == userProfile().data.collegeId && request.resource.data.collegeId == userProfile().data.collegeId) ||
        (isHOD() && resource.data.collegeId == userProfile().data.collegeId && resource.data.departmentId == userProfile().data.departmentId && request.resource.data.collegeId == userProfile().data.collegeId && request.resource.data.departmentId == userProfile().data.departmentId) ||
        (isFaculty() && resource.data.collegeId == userProfile().data.collegeId && resource.data.authorUserId == request.auth.uid && request.resource.data.collegeId == userProfile().data.collegeId && request.resource.data.authorUserId == request.auth.uid)
      );

      allow delete: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() ||
        (isCollegeAdmin() && resource.data.collegeId == userProfile().data.collegeId) ||
        (isHOD() && resource.data.collegeId == userProfile().data.collegeId && resource.data.departmentId == userProfile().data.departmentId) ||
        (isFaculty() && resource.data.collegeId == userProfile().data.collegeId && resource.data.authorUserId == request.auth.uid)
      );
    }
    // =========================================================
    // USER SETTINGS
    // =========================================================

    match /userSettings/{userId} {
      allow read, write: if isSignedIn() && isOwnUser(userId);
    }

    // =========================================================
    // OFFICIAL CERTIFICATES (REQUIREMENTS & SUBMISSIONS)
    // =========================================================

    match /officialCertificateRequirements/{requirementId} {
      allow read: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() ||
        (userProfile().data.collegeId == resource.data.collegeId)
      );

      allow create: if isSignedIn() && isActiveUser() && (
        (isCollegeAdmin() && request.resource.data.collegeId == userProfile().data.collegeId) ||
        (isHOD() && request.resource.data.collegeId == userProfile().data.collegeId && request.resource.data.departmentId == userProfile().data.departmentId && request.resource.data.applicableTo != 'college')
      );

      allow update: if isSignedIn() && isActiveUser() && (
        (isCollegeAdmin() && resource.data.collegeId == userProfile().data.collegeId && request.resource.data.collegeId == userProfile().data.collegeId) ||
        (isHOD() && resource.data.collegeId == userProfile().data.collegeId && resource.data.departmentId == userProfile().data.departmentId && request.resource.data.collegeId == userProfile().data.collegeId && request.resource.data.departmentId == userProfile().data.departmentId)
      );

      allow delete: if isSignedIn() && isActiveUser() && (
        (isCollegeAdmin() && resource.data.collegeId == userProfile().data.collegeId) ||
        (isHOD() && resource.data.collegeId == userProfile().data.collegeId && resource.data.departmentId == userProfile().data.departmentId)
      );
    }

    match /officialCertificates/{certificateId} {
      allow read: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() ||
        isOwnUser(resource.data.studentUid) ||
        (isCollegeAdmin() && userProfile().data.collegeId == resource.data.collegeId) ||
        (isHOD() && userProfile().data.collegeId == resource.data.collegeId && userProfile().data.departmentId == resource.data.departmentId) ||
        (isFaculty() && userProfile().data.collegeId == resource.data.collegeId && userProfile().data.departmentId == resource.data.departmentId)
      );

      allow create: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() ||
        (isStudent() && request.resource.data.studentUid == request.auth.uid && request.resource.data.collegeId == userProfile().data.collegeId && request.resource.data.status == 'pending') ||
        (isCollegeAdmin() && userProfile().data.collegeId == request.resource.data.collegeId) ||
        (isHOD() && userProfile().data.collegeId == request.resource.data.collegeId && userProfile().data.departmentId == request.resource.data.departmentId)
      );

      allow update: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() ||
        (isStudent() && resource.data.studentUid == request.auth.uid && request.resource.data.studentUid == request.auth.uid && request.resource.data.collegeId == userProfile().data.collegeId && request.resource.data.status == 'pending') ||
        (isCollegeAdmin() && userProfile().data.collegeId == resource.data.collegeId && request.resource.data.collegeId == userProfile().data.collegeId) ||
        (isHOD() && userProfile().data.collegeId == resource.data.collegeId && userProfile().data.departmentId == resource.data.departmentId && request.resource.data.collegeId == userProfile().data.collegeId && request.resource.data.departmentId == userProfile().data.departmentId)
      );

      allow delete: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() ||
        (isStudent() && resource.data.studentUid == request.auth.uid) ||
        (isCollegeAdmin() && userProfile().data.collegeId == resource.data.collegeId) ||
        (isHOD() && userProfile().data.collegeId == resource.data.collegeId && userProfile().data.departmentId == resource.data.departmentId)
      );
    }

    // =========================================================
    // ACHIEVEMENTS MODULE (Student accomplishments & portfolio)
    // =========================================================
    match /achievements/{achievementId} {
      allow read: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() ||
        isOwnUser(resource.data.studentUid) ||
        (isCollegeAdmin() && userProfile().data.collegeId == resource.data.collegeId) ||
        (isHOD() && userProfile().data.collegeId == resource.data.collegeId && userProfile().data.departmentId == resource.data.departmentId) ||
        (isFaculty() && userProfile().data.collegeId == resource.data.collegeId && userProfile().data.departmentId == resource.data.departmentId)
      );

      allow create: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() ||
        (isStudent() && request.resource.data.studentUid == request.auth.uid && request.resource.data.collegeId == userProfile().data.collegeId && request.resource.data.departmentId == userProfile().data.departmentId && request.resource.data.verificationStatus in ['unverified', 'pending'])
      );

      allow update: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() ||
        (isStudent() && resource.data.studentUid == request.auth.uid && request.resource.data.studentUid == request.auth.uid && request.resource.data.collegeId == userProfile().data.collegeId && request.resource.data.departmentId == userProfile().data.departmentId) ||
        (isCollegeAdmin() && userProfile().data.collegeId == resource.data.collegeId && request.resource.data.collegeId == userProfile().data.collegeId) ||
        (isHOD() && userProfile().data.collegeId == resource.data.collegeId && userProfile().data.departmentId == resource.data.departmentId && request.resource.data.collegeId == userProfile().data.collegeId && request.resource.data.departmentId == userProfile().data.departmentId) ||
        (isFaculty() && userProfile().data.collegeId == resource.data.collegeId && userProfile().data.departmentId == resource.data.departmentId && request.resource.data.collegeId == userProfile().data.collegeId && request.resource.data.departmentId == userProfile().data.departmentId)
      );

      allow delete: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() ||
        (isStudent() && resource.data.studentUid == request.auth.uid) ||
        (isCollegeAdmin() && userProfile().data.collegeId == resource.data.collegeId) ||
        (isHOD() && userProfile().data.collegeId == resource.data.collegeId && userProfile().data.departmentId == resource.data.departmentId)
      );
    }

    // Legacy certificates collection (backward compatibility)
    match /certificates/{certificateId} {
      allow read: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() ||
        isOwnUser(resource.data.studentUid) ||
        (isCollegeAdmin() && userProfile().data.collegeId == resource.data.collegeId) ||
        (isHOD() && userProfile().data.collegeId == resource.data.collegeId && userProfile().data.departmentId == resource.data.departmentId) ||
        (isFaculty() && userProfile().data.collegeId == resource.data.collegeId && userProfile().data.departmentId == resource.data.departmentId)
      );

      allow create: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() ||
        (isStudent() && request.resource.data.studentUid == request.auth.uid && request.resource.data.uploadedBy == request.auth.uid && request.resource.data.collegeId == userProfile().data.collegeId && (request.resource.data.isVerified == false || !('isVerified' in request.resource.data))) ||
        (isCollegeAdmin() && userProfile().data.collegeId == request.resource.data.collegeId) ||
        (isHOD() && userProfile().data.collegeId == request.resource.data.collegeId && userProfile().data.departmentId == request.resource.data.departmentId) ||
        (isFaculty() && userProfile().data.collegeId == request.resource.data.collegeId && userProfile().data.departmentId == request.resource.data.departmentId)
      );

      allow update: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() ||
        (isStudent() && resource.data.studentUid == request.auth.uid && request.resource.data.studentUid == request.auth.uid && request.resource.data.collegeId == userProfile().data.collegeId && request.resource.data.isVerified == resource.data.isVerified && request.resource.data.verifiedBy == resource.data.verifiedBy && request.resource.data.verifiedAt == resource.data.verifiedAt) ||
        (isCollegeAdmin() && userProfile().data.collegeId == resource.data.collegeId && request.resource.data.collegeId == userProfile().data.collegeId) ||
        (isHOD() && userProfile().data.collegeId == resource.data.collegeId && userProfile().data.departmentId == resource.data.departmentId && request.resource.data.collegeId == userProfile().data.collegeId && request.resource.data.departmentId == userProfile().data.departmentId) ||
        (isFaculty() && userProfile().data.collegeId == resource.data.collegeId && userProfile().data.departmentId == resource.data.departmentId && request.resource.data.collegeId == userProfile().data.collegeId && request.resource.data.departmentId == userProfile().data.departmentId)
      );

      allow delete: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() ||
        (isStudent() && resource.data.studentUid == request.auth.uid) ||
        (isCollegeAdmin() && userProfile().data.collegeId == resource.data.collegeId) ||
        (isHOD() && userProfile().data.collegeId == resource.data.collegeId && userProfile().data.departmentId == resource.data.departmentId) ||
        (isFaculty() && userProfile().data.collegeId == resource.data.collegeId && userProfile().data.departmentId == resource.data.departmentId)
      );
    }

    // =========================================================
    // CERTIFICATE REQUESTS
    // =========================================================

    match /certificateRequests/{requestId} {
      allow read: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() ||
        isOwnUser(resource.data.studentUserId) ||
        (isCollegeAdmin() && userProfile().data.collegeId == resource.data.collegeId) ||
        (isHOD() && userProfile().data.collegeId == resource.data.collegeId && userProfile().data.departmentId == resource.data.departmentId)
      );

      allow create: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() ||
        (isStudent() && request.resource.data.studentUserId == request.auth.uid && request.resource.data.collegeId == userProfile().data.collegeId && request.resource.data.status == 'pending') ||
        (isCollegeAdmin() && request.resource.data.collegeId == userProfile().data.collegeId) ||
        (isHOD() && request.resource.data.collegeId == userProfile().data.collegeId && request.resource.data.departmentId == userProfile().data.departmentId)
      );

      allow update: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() ||
        (isCollegeAdmin() && resource.data.collegeId == userProfile().data.collegeId && request.resource.data.collegeId == userProfile().data.collegeId) ||
        (isHOD() && resource.data.collegeId == userProfile().data.collegeId && resource.data.departmentId == userProfile().data.departmentId && request.resource.data.collegeId == userProfile().data.collegeId && request.resource.data.departmentId == userProfile().data.departmentId) ||
        (isStudent() && resource.data.studentUserId == request.auth.uid && request.resource.data.studentUserId == request.auth.uid && request.resource.data.status in ['pending', 'cancelled'] && request.resource.data.reviewedBy == resource.data.reviewedBy && request.resource.data.reviewedAt == resource.data.reviewedAt)
      );

      allow delete: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() ||
        (isCollegeAdmin() && resource.data.collegeId == userProfile().data.collegeId)
      );
    }

    // =========================================================
    // CERTIFICATE TYPES
    // =========================================================

    match /certificateTypes/{typeId} {
      allow read: if isSignedIn() && isActiveUser();
      allow create, update, delete: if isSignedIn() && isActiveUser() && (
        isSuperAdmin() ||
        isCollegeAdmin()
      );
    }

  }
}
