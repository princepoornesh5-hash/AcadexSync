# ── ACADEX Staging Environment Configuration Template ───────
# Use this template to configure your online staging backend environment variables in your cloud hosting provider (Render, Railway, etc.)

# MongoDB Atlas Staging Database Connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/acadex?retryWrites=true&w=majority
MONGODB_DATABASE=acadex

# Server Settings (Set automatically by cloud provider if omitted)
PORT=5050
NODE_ENV=production

# JWT & Authentication Cryptographic Secrets (Minimum 32 characters in production)
JWT_SECRET=acadex_staging_jwt_master_secret_key_32_chars_min!
JWT_ACCESS_SECRET=acadex_staging_access_token_secret_key_32_chars!
JWT_REFRESH_SECRET=acadex_staging_refresh_token_secret_key_32_chars!
JWT_RESET_SECRET=acadex_staging_reset_token_secret_key_32_chars!
ACTIVATION_CODE_SECRET=acadex_staging_activation_code_secret_32_chars!

# Token Expirations (in seconds)
ACCESS_TOKEN_EXPIRES_IN=900
REFRESH_TOKEN_EXPIRES_IN=604800
PASSWORD_RESET_TOKEN_EXPIRES_IN=600
INVITATION_EXPIRES_IN=604800

# OTP & Password Security
OTP_EXPIRES_IN=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60
BCRYPT_SALT_ROUNDS=10

# CORS Allowed Origins
CORS_ORIGIN=*

# ImageKit Media & File Storage
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_endpoint

# Storage Limits
NOTES_MAX_FILE_SIZE_MB=25
PROFILE_IMAGE_MAX_FILE_SIZE_MB=5
SIGNED_URL_EXPIRY_SECONDS=300

# Firebase Admin Push Notifications
FIREBASE_PROJECT_ID=acadex-app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@acadex-app.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=""

# Google Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
AI_RATE_LIMIT_MAX=30
AI_TIMEOUT_MS=15000
