# MongoDB Atlas Connection Configuration
MONGODB_URI=mongodb+srv://acadex_backend:<password>@acadexsync.xxxxx.mongodb.net/acadex?retryWrites=true&w=majority
MONGODB_DATABASE=acadex

# Server Settings
PORT=5000
NODE_ENV=development

# JWT & Authentication Secrets (Must be at least 32 characters in production)
JWT_SECRET=acadex_development_jwt_secret_min_32_chars!
JWT_ACCESS_SECRET=acadex_development_access_token_secret_min_32_chars!
JWT_REFRESH_SECRET=acadex_development_refresh_token_secret_min_32_chars!
JWT_RESET_SECRET=acadex_development_reset_token_secret_min_32_chars!
ACTIVATION_CODE_SECRET=acadex_development_activation_secret_32_chars!

# Token Expiry (in seconds)
ACCESS_TOKEN_EXPIRES_IN=900
REFRESH_TOKEN_EXPIRES_IN=604800
PASSWORD_RESET_TOKEN_EXPIRES_IN=600
INVITATION_EXPIRES_IN=604800

# OTP & Password Security
OTP_EXPIRES_IN=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60
BCRYPT_SALT_ROUNDS=10

# CORS Settings (Comma-separated list of origins, e.g. https://acadex.edu,https://admin.acadex.edu. Wildcard * allowed in development only)
CORS_ORIGIN=*

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=15
UPLOAD_RATE_LIMIT_MAX=30
REPORT_RATE_LIMIT_MAX=60
INVITATION_RATE_LIMIT_MAX=30
DEVICE_TOKEN_RATE_LIMIT_MAX=30

# ImageKit Media & File Storage Configuration
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Storage Limits & Expirations
NOTES_MAX_FILE_SIZE_MB=25
PROFILE_IMAGE_MAX_FILE_SIZE_MB=5
SIGNED_URL_EXPIRY_SECONDS=300

# Firebase Admin / FCM Push Notifications Configuration
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your_firebase_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
